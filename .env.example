# Copy to .env to override. Compose has the same defaults inline, so .env is optional.
# Local development credentials only.
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_DB=relay

# Report parameters (all optional; these are the defaults, see plans/T2-backend-core.md §1e).
# REPORT_BASELINE_WEEKS=12
# REPORT_MIN_HISTORY_WEEKS=8
# REPORT_Z_MIN=2.0
# REPORT_MIN_ABS=3.0
# REPORT_MIN_BASELINE_MEDIAN=4.0

# Demo account used when the X-Account-Id header is missing (a demo choice, not a data property).
# DEMO_ACCOUNT_ID=15

# AI summary (optional, off by default; see README "AI summary: status").
# Set LLM_SUMMARY_ENABLED=true and run `make up` to turn it on. The mock provider is the default
# and needs no key; its output is labeled as a preview, never as a model's.
# LLM_SUMMARY_ENABLED=false
# SUMMARY_PROVIDER=mock
# Real model (optional): SUMMARY_PROVIDER=anthropic plus a key below; the default model is claude-haiku-5-5.
# ANTHROPIC_API_KEY=
# SUMMARY_MODEL=claude-haiku-5-5
# SUMMARY_MOCK_MODE=ok
# SUMMARY_TIMEOUT_SECONDS=5
# SUMMARY_MAX_TOKENS=1024
